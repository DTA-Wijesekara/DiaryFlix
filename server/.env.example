# CineLog backend environment template
# Copy this file to .env and fill in values appropriate for your environment.
# Never commit the real .env file.

# --- Runtime ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Auth ---
# Must be at least 32 characters in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- PostgreSQL ---
DATABASE_URL=postgresql://diaryflix:change-me@localhost:5432/diaryflix
# false only for a local, non-TLS database. Cloud connections verify certificates.
DB_SSL=false
# DB_SSL_CA= (optional PEM certificate for a private CA)
# TRUST_PROXY= (comma-separated trusted proxy IPs/CIDRs; never use a blanket true)

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for any.
# In production set this to your frontend URL, e.g. https://cinelog.example.com
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=false

# --- Rate limits ---
# Max login/register attempts per IP per 15 min
RATE_AUTH_MAX=10
# Max general API requests per IP per minute
RATE_API_MAX=120

# --- Google Sign-In ---
# OAuth Client ID from Google Cloud Console (Web application).
# Without this, /api/auth/google will be disabled.
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
# Without SMTP_USER/SMTP_PASS, /api/auth/forgot-password will return success
# but no email is sent. Tokens are never logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- App URL (used to build links in emails, e.g. password reset) ---
APP_URL=http://localhost:5173

# --- Password reset ---
PASSWORD_RESET_TTL_MIN=60

# --- Password policy ---
PASSWORD_MIN=8

# --- Body parser ---
BODY_LIMIT=256kb

# --- Admin seeding (opt-in only) ---
# If true, db:migrate creates an admin using the values below. Verify it through email recovery.
# Leave SEED_ADMIN unset or set to "false" to disable default admin creation.
SEED_ADMIN=false
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=  # pick a strong password
# SEED_ADMIN_NAME=Admin

# Optional: restrict database TCP connections to IPv4 on networks with broken IPv6.
# DB_IP_FAMILY=4
